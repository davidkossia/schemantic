{
  "name": "schemantic",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-agent STEM problem solver: reads circuit and graph images into structured data, with human review before solving.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "tsx eval/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "dotenv": "^18.0.10",
    "mathjs": "^15.2.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
